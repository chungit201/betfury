# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Whitelist signups are real email addresses collected at runtime. They belong
# on the server, not in version control — and committing them to a public repo
# would publish them.
/data/

# Scratch output from the image-generation scripts (candidates, raw renders).
# Regenerate with the scripts in scripts/ rather than carrying ~100MB in git.
/logo-options/

# Deploy scratch
.deploy-ip
