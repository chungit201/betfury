# Copy to .env and fill in. .env is gitignored; never commit real values.
#
# The deployed app does NOT read this file. On the VM these come from
# /etc/inuslots/env (0600, root), which scripts/server-deploy.sh sources and
# hands to pm2. This file is for local development only.

# Image generation for scripts/gen-*.mjs. Not needed to run the site.
GEMINI_API_KEY=

# Accounts database.
#
# The production database listens on the VM's loopback only, so this URI works
# from a laptop only while an SSH tunnel is forwarding the port:
#
#   npm run tunnel
#
# Copy the real value from the VM:
#   gcloud compute ssh inuslots-web --zone=asia-southeast1-a --project=auro-finance \
#     --command="sudo grep MONGODB_URI /etc/inuslots/env"
#
# That points at PRODUCTION data. Register with probe- addresses and clear them
# with scripts/server-clean-probes.sh on the VM. To develop against a throwaway
# database instead, install MongoDB locally and use:
#   MONGODB_URI=mongodb://127.0.0.1:27017/inuslots_dev
MONGODB_URI=

# Signs the session cookie. Any long random string works locally; changing it
# invalidates every existing session.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Bearer token for /api/admin/users, used by scripts/admin-users.mjs.
# Must match the VM's value if you are tunnelled to the production database.
ADMIN_TOKEN=

# Absolute site URL, used for metadataBase and og:image.
# Defaults to http://localhost:3000 when unset.
SITE_URL=
